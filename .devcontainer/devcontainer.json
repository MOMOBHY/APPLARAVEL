{
  "name": "Plateforme GFP",
  "image": "mcr.microsoft.com/devcontainers/php:1-8.4-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "containerEnv": {
    "XDEBUG_MODE": "off"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Plateforme GFP",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "postAttachCommand": "bash .devcontainer/start.sh && bash .devcontainer/port-public.sh"
}
